DATABASE_URL=postgresql+psycopg2://localhost/job_apply_assistant
JWT_SECRET=change-me
ANTHROPIC_API_KEY=
# Powers the resume/job fit score shown before tailoring. From
# https://dash.typesafe.ai. Optional — GET /tailoring/fit-score just
# fails with a 502 if unset.
TYPESAFE_API_KEY=
RESUME_STORAGE_DIR=./storage/resumes
RENDERED_PDF_DIR=./storage/rendered
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
CHECKOUT_SUCCESS_URL=http://localhost:8000/billing/success
CHECKOUT_CANCEL_URL=http://localhost:8000/billing/cancel

# RAG-tailored resumes (../newProjectRAG) — only needed for POST /tailoring
# with "use_rag": true. From https://dash.voyageai.com.
VOYAGE_API_KEY=
# Set to 1 to use a deterministic offline embedding fallback instead of
# calling Voyage — no network, no API key needed.
RAG_FAKE_EMBEDDINGS=0
