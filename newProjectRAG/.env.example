# Add this alongside backend/.env's variables (this project reads the same
# environment — run it from within backend's activated virtualenv).

# From https://dash.voyageai.com — Voyage AI provides embeddings (Anthropic
# doesn't have its own embeddings endpoint and recommends Voyage).
VOYAGE_API_KEY=

# Set to 1 to use a deterministic offline embedding fallback instead of
# calling Voyage — no network, no API key needed. Useful for local dev
# without Voyage credits. Tests always run with this set.
RAG_FAKE_EMBEDDINGS=0
